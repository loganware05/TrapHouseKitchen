# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/database_name?schema=public

# JWT Configuration
# Production (NODE_ENV=production) refuses to start if JWT_SECRET is missing or equals "default-secret".
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Password-reset smoke without Resend: include resetUrl in forgot-password JSON when
# SHOW_PASSWORD_RESET_LINK=1 AND (NODE_ENV !== production OR APP_ENV=staging).
# Never set APP_ENV=staging or SHOW_PASSWORD_RESET_LINK on production Render.
# SHOW_PASSWORD_RESET_LINK=1
# APP_ENV=staging

# Stripe Configuration
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Email Configuration (Resend)
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=TrapHouse Kitchen <orders@yourdomain.com>
CHEF_EMAIL=chef@yourdomain.com

# Review System Configuration
REVIEW_WINDOW_DAYS=30

# AI meal builder (set at least one key)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=1024

# PWA Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
# Never commit real private keys. Omit or leave blank to disable outbound push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@yourdomain.com
